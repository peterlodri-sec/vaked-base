{
  "productName": "Vaked IDE",
  "version": "0.1.0",
  "identifier": "io.vaked.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vaked IDE",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "identifier": "dev.vaked.ide",
    "publisher": "Vaked Constellation",
    "category": "Developer Tool",
    "copyright": "Copyright \u00a9 2026 Vaked Constellation. All rights reserved.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15.0",
      "exceptionDomain": "",
      "entitlements": "Entitlements.plist"
    }
  }
}